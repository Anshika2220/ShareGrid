PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/sharegrid
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ShareGrid <no-reply@sharegrid.local>
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PRIVATE_UPLOAD_DIR=./private-uploads
UPLOAD_MAX_BYTES=10485760
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DEMO_PAYMENTS_ENABLED=true
ADMIN_EMAILS=
