PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/sharegrid
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ShareGrid <no-reply@sharegrid.local>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PRIVATE_STORAGE_DRIVER=local
PRIVATE_UPLOAD_DIR=./private-uploads
UPLOAD_MAX_BYTES=10485760
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DEMO_PAYMENTS_ENABLED=true
